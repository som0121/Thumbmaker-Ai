# Copy this file to .env and fill in your real values.
# .env is ignored by git; this example file is safe to commit.

OPENROUTER_API_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=

# Google OAuth client ID (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
# Random secret used to sign session tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Set to true in production (HTTPS only cookie)
COOKIE_SECURE=false
